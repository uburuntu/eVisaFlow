# Build context excludes for the combined web+service image (service/Dockerfile).
# Goal: a small, deterministic context. The image is built entirely inside the
# Dockerfile from source — dependencies are installed from the committed lockfile
# and every artifact (root lib dist, service dist, web/dist) is produced in the
# builder stage. So all local install/build outputs are excluded here; what the
# build needs (source, manifests, lockfile, configs, SQL migrations) is kept.

# Dependencies — reinstalled in-image from pnpm-lock.yaml (root + every workspace).
**/node_modules

# Build outputs — rebuilt in-image (root tsup `dist/`, `service/dist`, `web/dist`).
**/dist

# Astro cache + generated types — regenerated by `astro build`.
web/.astro

# Runtime/download data — never part of an image (and may hold personal data).
downloads
**/downloads

# Captured page data and test artifacts — not needed to build or run.
snapshots
tests
**/tests

# Secrets / local env — NEVER copy into the build context or image.
**/.env
**/.env.*
config.json
test-credentials.json

# VCS, CI, editor, OS noise.
.git
.github
.gitignore
**/*.log
**/.DS_Store

# Local-only debug helpers (gitignored anyway; keep them out of the context).
scripts/debug-flow.js
**/.verify-and-commit.sh
**/.finish-*.sh

# This project's own container/compose files are not needed inside the image.
Dockerfile
**/Dockerfile
**/docker-compose*.yml
.dockerignore
