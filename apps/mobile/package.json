{
  "name": "evisa-flow-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "pnpm --filter @evisa-flow/protocol build",
    "start": "expo start",
    "preandroid": "pnpm --filter @evisa-flow/protocol build",
    "android": "expo run:android",
    "preios": "pnpm --filter @evisa-flow/protocol build",
    "ios": "expo run:ios",
    "e2e": "maestro test e2e/maestro/flows",
    "e2e:smoke": "maestro test --include-tags=smoke e2e/maestro/flows",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@evisa-flow/protocol": "workspace:*",
    "@supabase/supabase-js": "^2.111.0",
    "expo": "56.0.17",
    "expo-build-properties": "56.0.24",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "56.0.22",
    "expo-crypto": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-linking": "56.0.16",
    "expo-print": "~56.0.4",
    "expo-router": "56.2.16",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.23",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "lucide-react-native": "1.27.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.85.3",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
