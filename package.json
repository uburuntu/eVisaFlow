{
  "name": "evisa-flow",
  "version": "2.0.2",
  "description": "Automated UK eVisa share code + PDF retrieval via Playwright.",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "evisa-flow": "bin/evisa-flow.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./unstable/testing": {
      "types": "./dist/unstable/testing.d.ts",
      "import": "./dist/unstable/testing.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md",
    "config.sample.json"
  ],
  "scripts": {
    "audit": "node ./scripts/audit.js",
    "build": "pnpm run build:service",
    "build:lib": "pnpm run build:protocol && tsup && tsc --emitDeclarationOnly --declarationMap false",
    "build:protocol": "pnpm --filter @evisa-flow/protocol build",
    "build:service": "pnpm run build:lib && pnpm --filter evisa-flow-bot build",
    "check:mobile": "node ./scripts/check-mobile-toolchain.js",
    "check:toolchain": "node ./scripts/check-toolchain.js",
    "dev": "pnpm run build:protocol && tsup --watch --onSuccess \"tsc --emitDeclarationOnly --declarationMap false\"",
    "dev:mobile": "pnpm --filter evisa-flow-mobile start",
    "e2e:mobile": "pnpm --filter evisa-flow-mobile e2e",
    "e2e:mobile:smoke": "pnpm --filter evisa-flow-mobile e2e:smoke",
    "format": "biome check --write .",
    "format:check": "biome ci . --reporter=summary --error-on-warnings",
    "lint": "biome ci . --reporter=summary --error-on-warnings",
    "pack:dry": "pnpm pack --dry-run",
    "start": "node ./bin/evisa-flow.js",
    "prepack": "pnpm run build:lib",
    "snapshots": "node ./scripts/snapshot.js",
    "smoke:live": "pnpm run build:lib && node ./scripts/live-smoke.js",
    "fixtures": "node ./scripts/refresh-fixtures.js",
    "test": "pnpm run build && pnpm run test:built",
    "test:built": "node --test tests/*.test.js && node --test service/tests/*.test.js && pnpm run test:mobile",
    "test:lib": "pnpm run build:lib && node --test tests/*.test.js",
    "test:mobile": "pnpm --filter evisa-flow-mobile test",
    "test:service": "pnpm run build:lib && pnpm --filter evisa-flow-bot build && node --test service/tests/*.test.js",
    "typecheck": "pnpm run typecheck:protocol && pnpm run typecheck:lib && pnpm run typecheck:service && pnpm run typecheck:mobile",
    "typecheck:lib": "pnpm run build:protocol && tsc --noEmit",
    "typecheck:protocol": "pnpm --filter @evisa-flow/protocol typecheck",
    "typecheck:service": "pnpm run build:lib && pnpm --filter evisa-flow-bot typecheck",
    "typecheck:mobile": "pnpm run build:protocol && pnpm --filter evisa-flow-mobile typecheck",
    "validate": "pnpm run lint && pnpm run check:toolchain && pnpm run check:mobile && pnpm run typecheck && pnpm run build && pnpm run test:built && pnpm run pack:dry && pnpm run audit"
  },
  "keywords": [
    "evisa",
    "govuk",
    "share-code",
    "immigration",
    "playwright",
    "automation",
    "uk",
    "pdf"
  ],
  "author": "Ramzan Bekbulatov",
  "repository": {
    "type": "git",
    "url": "https://github.com/uburuntu/eVisaFlow.git"
  },
  "bugs": {
    "url": "https://github.com/uburuntu/eVisaFlow/issues"
  },
  "homepage": "https://github.com/uburuntu/eVisaFlow#readme",
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "pino": "^10.3.1",
    "playwright": "1.62.0",
    "prompts": "^2.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
