# Deployment profile. `selfhost` (default) = web-first, one `docker compose up`,
# no billing/provider-mailer/R2. `cloud` is reserved for the later paid tier.
DEPLOYMENT_MODE=selfhost

# Opt-in Telegram bot. Web-first: defaults to OFF so a pure-web self-host runs
# with NO Telegram account and never uses the server encryption key (web runs are
# client-custody, E2EE). Set to true to also run the Telegram channel — then
# TELEGRAM_BOT_TOKEN and ENCRYPTION_KEY below become REQUIRED.
ENABLE_BOT=false

# Postgres connection string (Drizzle + pg). ALWAYS required. The migration
# runner applies the schema on startup, so no SQL needs to be pasted anywhere.
#   - Supabase deployment: the project's Postgres connection string
#     (Settings → Database → Connection string).
#   - Self-host: the bundled Postgres, e.g.
#     postgres://postgres:postgres@localhost:5432/evisaflow
# SAFETY: point this ONLY at a local/ephemeral database while developing or
# testing — never at a managed/production database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/evisaflow

# Telegram bot token — get from @BotFather. Required ONLY when ENABLE_BOT=true.
TELEGRAM_BOT_TOKEN=

# Server-custody AES key for the Telegram bot — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required ONLY when ENABLE_BOT=true. Pure-web runs are client-custody and never
# use this key, so a bot-less deployment can leave it blank.
ENCRYPTION_KEY=

# Queue
QUEUE_CONCURRENCY=2

# eVisaFlow
EVISA_HEADLESS=true
EVISA_DIAGNOSTICS_MODE=sanitized_on_failure

# Web server — the Fastify API and the health probes (/live, /ready) share this
# one port. Default 8080.
PORT=8080
# DEPRECATED: health now lives on PORT (above). Kept only so existing
# deployments that still set HEALTH_PORT load without error; the value is ignored.
HEALTH_PORT=8080
# Path to the built web bundle (web/dist) the server serves at this same origin,
# with an SPA fallback for /app/*. Optional: defaults to the workspace web/dist
# (resolved relative to the running module), so a built self-host image and
# `node dist/index.js` both find it. Set only if the bundle lives elsewhere. If
# the build is absent, the API still runs and a hint is logged. Build it with
# `pnpm --filter @evisaflow/web build`.
# WEB_DIST_PATH=

# Scheduler
SCHEDULER_CRON=0 9 * * *
SCHEDULE_INTERVAL_DAYS=30

# Cleanup cron — deletes expired sealed run artifacts, expired sessions, and
# consumed/expired magic-link tokens. Runs hourly by default.
CLEANUP_CRON=0 * * * *
# How long sealed run artifacts (PDFs, checker HTML) live before cleanup removes
# them. Default 24h (1440 minutes).
ARTIFACT_TTL_MINUTES=1440

# Web auth
# Externally reachable origin (scheme + host[:port], no trailing slash). Used to
# build the magic-link verification URL emailed to users, so set it to the real
# public origin in production (e.g. https://evisaflow.example).
PUBLIC_BASE_URL=http://localhost:8080
# Web session lifetime in minutes. Default 30 days.
SESSION_TTL_MINUTES=43200
# Magic-link token lifetime in minutes. Short by design. Default 15.
MAGIC_LINK_TTL_MINUTES=15
# Optional SMTP transport for magic-link email. Leave SMTP_URL blank to log the
# link instead (console mailer) — fine for dev or a Telegram-only self-host. When
# set, SMTP_FROM is required.
#   SMTP_URL=smtps://user:pass@smtp.example.com:465
#   SMTP_FROM=eVisaFlow <noreply@example.com>
SMTP_URL=
SMTP_FROM=
