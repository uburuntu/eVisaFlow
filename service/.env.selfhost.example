# Minimal env for the one-command, web-first self-host.
#
#   cp service/.env.selfhost.example service/.env
#   # edit service/.env: set SESSION_SECRET (required)
#   docker compose -f service/docker-compose.selfhost.yml up
#
# This file is read by docker-compose.selfhost.yml. The compose file supplies
# DATABASE_URL (the bundled Postgres), DEPLOYMENT_MODE=selfhost, and ENABLE_BOT
# automatically — so the ONLY value you must set for a pure-web install is
# SESSION_SECRET. Everything else has a working default.
#
# SAFETY: secrets live here at runtime only; nothing is baked into the image, and
# service/.env is gitignored. Keep the bundled Postgres for local/self-host use —
# never point the app at a managed/production database.

# REQUIRED. Secret that signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters.
SESSION_SECRET=

# Port the app listens on inside the container AND publishes to the host (the
# compose file maps ${PORT}:${PORT}). The app serves the web UI, the API, and the
# /ready and /live health probes all on this one port. Default 8080.
PORT=8080

# Externally reachable origin (scheme + host[:port], no trailing slash). Used to
# build the magic-link sign-in URL, so set it to the URL users actually visit. For
# a local run the default is fine; behind a domain/reverse proxy set the real
# origin, e.g. https://evisa.example.com
PUBLIC_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Opt-in Telegram bot. Leave OFF for a pure-web install (no Telegram account
# needed). Set ENABLE_BOT=true to ALSO run the bot — then the two values below
# become REQUIRED:
#   - TELEGRAM_BOT_TOKEN: from @BotFather
#   - ENCRYPTION_KEY: 32-byte hex, server-custody AES for the bot's stored docs:
#       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Web runs are client-custody (end-to-end encrypted) and never use ENCRYPTION_KEY.
# ---------------------------------------------------------------------------
ENABLE_BOT=false
TELEGRAM_BOT_TOKEN=
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Optional: bundled Postgres credentials. The compose file defaults these to
# postgres/postgres/evisaflow and wires DATABASE_URL to the internal `postgres`
# service for you. Override only if you want different local credentials; the app
# DATABASE_URL is derived from these automatically.
# ---------------------------------------------------------------------------
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=evisaflow

# ---------------------------------------------------------------------------
# Optional: send real magic-link emails. Without SMTP the link is written to the
# app logs (fine for local use and for a Telegram-login-only install). When
# SMTP_URL is set, SMTP_FROM is required.
# ---------------------------------------------------------------------------
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_FROM=eVisaFlow <noreply@example.com>
