{
  "name": "evisa-flow-bot",
  "version": "1.0.0",
  "description": "Telegram bot for automated UK eVisa share code retrieval.",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome ci . --reporter=summary --error-on-warnings",
    "start": "node --env-file=.env dist/index.js",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "author": "Ramzan Bekbulatov",
  "license": "MIT",
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/runner": "^2.0.3",
    "drizzle-orm": "^0.44.6",
    "evisa-flow": "workspace:*",
    "grammy": "^1.42.0",
    "libsodium-wrappers": "^0.7.15",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "typescript": "^6.0.3"
  }
}
