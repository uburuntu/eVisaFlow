{
  "name": "evisa-flow-bot",
  "version": "1.0.0",
  "description": "Telegram bot for automated UK eVisa share code retrieval.",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome ci . --reporter=summary --error-on-warnings",
    "start": "node --env-file=.env dist/index.js",
    "start:api": "node --env-file=.env dist/api/index.js",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "author": "Ramzan Bekbulatov",
  "license": "MIT",
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/runner": "^2.0.3",
    "@supabase/supabase-js": "^2.111.0",
    "evisa-flow": "workspace:*",
    "fastify": "^5.10.0",
    "grammy": "^1.45.1",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}
