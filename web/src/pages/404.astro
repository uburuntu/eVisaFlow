---
import Layout from "../layouts/Layout.astro";

/**
 * Custom 404. Astro emits this as `404.html`; the Fastify static mount serves it
 * for unknown paths. Keeps the brand and offers a clear way back rather than a
 * bare server error page.
 */
---

<Layout
  title="Page not found"
  description="The page you were looking for doesn't exist."
  noindex={true}
  mainClass="notfound"
>
  <section class="section">
    <div class="container container--narrow notfound__inner stack-lg">
      <p class="notfound__code" aria-hidden="true">404</p>
      <h1>We couldn't find that page</h1>
      <p class="lead">
        The link may be broken or the page may have moved. Let's get you back on
        track.
      </p>
      <div class="notfound__actions">
        <a href="/" class="btn">Back to home</a>
        <a href="/docs" class="btn btn--ghost">Browse the docs</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .notfound {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  .notfound__code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 3rem + 8vw, 8rem);
    font-weight: 600;
    line-height: 0.9;
    color: var(--brand);
    opacity: 0.18;
    margin: 0;
  }
  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
</style>
